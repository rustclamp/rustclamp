# Local settings; real environment variables win.
APP_ENV=local
# Encrypts app data; `clamp key:generate` sets it. Never commit it.
APP_KEY=
# sqlite; DB_DATABASE is a file path or :memory:
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
API_PER_MINUTE=60
TRUST_PROXY=false
# debug, info, notice, warning, error, critical, alert, emergency, or silent
LOG_LEVEL=debug
# single (storage/logs/app.log), daily (app-YYYY-MM-DD.log, LOG_DAILY_DAYS kept),
# stderr, or stack (every channel in LOG_STACK)
LOG_CHANNEL=single
LOG_DAILY_DAYS=14
LOG_STACK=daily,stderr
