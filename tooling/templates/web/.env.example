# Local settings; real environment variables win.
APP_ENV=local
# Encrypts app data; `clamp key:generate` sets it. Never commit it.
APP_KEY=
# sqlite; DB_DATABASE is a file path or :memory:
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
# local (storage/app/private) or public (storage/app/public, served at /storage)
FILESYSTEM_DISK=local
API_PER_MINUTE=60
TRUST_PROXY=false
# debug, info, notice, warning, error, critical, alert, emergency, or silent
LOG_LEVEL=debug
# single (storage/logs/app.log), daily (app-YYYY-MM-DD.log, LOG_DAILY_DAYS kept),
# stderr, or stack (every channel in LOG_STACK)
LOG_CHANNEL=single
LOG_DAILY_DAYS=14
LOG_STACK=daily,stderr
# With rustclamp's `queue` feature: database (a `jobs` table) or redis
# (REDIS_URL, keys under REDIS_PREFIX, which production requires).
# QUEUE_WORKERS run beside the server (default 1, 0 in production, where
# `<app> queue:work` runs them as their own service).
QUEUE_CONNECTION=database
QUEUE_WORKERS=1
QUEUE_TRIES=3
# Seconds before an unfinished job runs again; keep it above the slowest job.
QUEUE_RETRY_AFTER=90
# With rustclamp's `schedule` feature: run scheduled tasks beside the server
# (default true, false in production, where cron runs `<app> schedule:run`
# every minute). An unfinished run older than SCHEDULE_STALE_AFTER seconds
# counts as dead.
SCHEDULE_THREAD=true
SCHEDULE_STALE_AFTER=3600
